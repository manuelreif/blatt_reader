# Kopieren nach .env (wird nicht committet).
# DeepL API Free: https://www.deepl.com/pro-api  (Free-Keys enden auf ":fx")
DEEPL_API_KEY=
# Optional: 1 = DEEPL_API_KEY nie benutzen, jedes Gerät braucht einen eigenen Key (Einstellungen → Eigener DeepL-Key).
DEEPL_REQUIRE_OWN_KEY=
# Optional: geheimes Token, das die App bei jeder Anfrage mitschickt (Einstellungen → App-Token).
APP_TOKEN=
# Optional: Passwortschutz für die ganze App (Anmeldeseite unter /login). Online als Secret setzen.
APP_PASSWORD=
# Optional: Abgleich mit Google Drive (Bücherordner + Lernstand). OAuth-Client-ID vom Typ „Webanwendung“,
# Einrichtung siehe README → „Google Drive“. Öffentlich, kein Secret: wird beim Build in die App eingebaut.
VITE_GOOGLE_CLIENT_ID=
